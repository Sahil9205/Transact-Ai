{
  "openapi": "3.1.0",
  "info": {
    "title": "Transact AI Commerce Gateway",
    "description": "Autonomous commerce actions for ChatGPT & Gemini. Allows natural language product discovery, live warehouse stock check, spending limit enforcement, and Razorpay test checkout generation.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://transact-ai-production.up.railway.app",
      "description": "Production Railway Gateway"
    }
  ],
  "paths": {
    "/api/v1/hosts/execute-tool": {
      "post": {
        "operationId": "executeCommerceTool",
        "summary": "Execute an autonomous commerce tool",
        "description": "Dispatches a verified commerce operation: search_products, get_product_details, verify_order_preflight, create_payment_order, find_smart_alternatives, or get_order_timeline.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["tool_name", "arguments"],
                "properties": {
                  "tool_name": {
                    "type": "string",
                    "enum": [
                      "search_products",
                      "get_product_details",
                      "verify_order_preflight",
                      "create_payment_order",
                      "find_smart_alternatives",
                      "get_order_timeline"
                    ],
                    "description": "The name of the commerce tool to run."
                  },
                  "arguments": {
                    "type": "object",
                    "description": "Key-value arguments matching the specified tool."
                  },
                  "user_id": {
                    "type": "string",
                    "default": "chatgpt_user",
                    "description": "Unique user identifier."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tool execution result with live verified stock, prices, or payment links.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "tool": {
                      "type": "string",
                      "description": "Executed tool name"
                    },
                    "status": {
                      "type": "string",
                      "description": "Execution status: success or error"
                    },
                    "result": {
                      "type": "object",
                      "description": "Output payload of the tool"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/agent/chat": {
      "post": {
        "operationId": "chatCommerceAgent",
        "summary": "Run full autonomous commerce workflow for a user prompt",
        "description": "Takes a natural language prompt (English, Hindi, Hinglish), parses intent, searches Qdrant vectors, verifies stock via Gatekeeper, and generates an order proposal.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["prompt"],
                "properties": {
                  "user_id": {
                    "type": "string",
                    "default": "chatgpt_user"
                  },
                  "prompt": {
                    "type": "string",
                    "example": "1kg Rasgulla under 500 in 110001"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Orchestrated proposal or smart recovery alternatives.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user_id": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "description": "Workflow status: completed, policy_rejected, recovery_suggested"
                    },
                    "agent_message": {
                      "type": "string",
                      "description": "Natural language response message"
                    },
                    "order_proposal": {
                      "type": "object",
                      "description": "Proposed order details"
                    },
                    "alternatives": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      },
                      "description": "Alternative product recommendations"
                    },
                    "step_history": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Execution path trace of LangGraph nodes"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
