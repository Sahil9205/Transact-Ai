# Application Environment
APP_ENV=development
APP_NAME=Transact AI
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# Database Connection (SQLite local / PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./data/commerce.db

# Razorpay Test / Live Keys (https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_HERE
RAZORPAY_KEY_SECRET=YOUR_SECRET_HERE
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET_HERE

# Qdrant Cloud Vector Database (https://cloud.qdrant.io)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=transact_products

# LangSmith Observability & Tracing (https://smith.langchain.com)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=transact-ai
LANGCHAIN_TRACING_V2=true
