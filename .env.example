# App config
APP_ENV=development
APP_NAME="Transact AI"
APP_VERSION="0.1.0"
LOG_LEVEL=INFO

# Database setup
DATABASE_URL=sqlite+aiosqlite:///./data/commerce.db

# Payments
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# Vector Database (Qdrant Cloud)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=products

# LangSmith Observability & Tracing
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=transact-ai
LANGCHAIN_TRACING_V2=true

# LLM Integrations
# LLM_PROVIDER=
# LLM_API_KEY=
# GEMINI_API_KEY=
